<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parking.client.controller.DailySaleController"
      styleClass="screen" alignment="TOP_CENTER" spacing="20" prefWidth="700" prefHeight="600">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    <Label text="DAILY SALE" styleClass="title"/>
    <TableView fx:id="saleTable" prefHeight="350">
        <columns>
            <TableColumn fx:id="bayColumn" text="Parking Bay" prefWidth="300"/>
            <TableColumn fx:id="saleColumn" text="Daily Sale" prefWidth="300"/>
        </columns>
    </TableView>
    <HBox alignment="CENTER" spacing="15">
        <Label text="TOTAL SALE"/>
        <TextField fx:id="totalField" editable="false"/>
    </HBox>
</VBox>
